{
  "name": "ml-lab-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "dev:frontend": "vite",
    "dev:stack": "concurrently -k -n backend,frontend -c cyan,green \"npm run backend\" \"npm run dev:frontend\"",
    "web:dev": "vite",
    "backend": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8765 --reload",
    "tauri": "tauri",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:backend": "python -m pytest backend/tests",
    "test:frontend": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.2.0",
    "lucide-react": "^0.468.0",
    "plotly.js-dist-min": "^2.35.2",
    "react": "^18.3.1",
    "react-data-grid": "7.0.0-beta.47",
    "react-dom": "^18.3.1",
    "react-plotly.js": "^2.6.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
